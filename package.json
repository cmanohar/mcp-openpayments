{
  "name": "mcp-openpayments",
  "version": "0.1.0",
  "description": "MCP server for CMS Open Payments (Sunshine Act) — physician-industry payments, manufacturer spending, research funding, teaching hospital payments. No API key required.",
  "author": "Chinmay Manohar",
  "license": "MIT",
  "type": "module",
  "bin": {
    "mcp-openpayments": "dist/index.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "mcp",
    "openpayments",
    "sunshine-act",
    "physician-payments",
    "cms",
    "pharmaceutical",
    "model-context-protocol",
    "claude",
    "llm"
  ],
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.1"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.7.0",
    "vitest": "^4.1.0"
  },
  "engines": {
    "node": ">=18"
  }
}
